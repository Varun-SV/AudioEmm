# Copy to .env and fill in values before running docker-compose

# Database
POSTGRES_PASSWORD=changeme

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-secret-in-production

# OAuth — leave blank to disable that provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL of the app (used for OAuth redirect URIs)
# Must match what you register with Google/GitHub
OAUTH_REDIRECT_BASE=https://yourdomain.com

# CORS — comma-separated list of allowed origins, or * for dev
ALLOWED_ORIGINS=https://yourdomain.com

# GPU acceleration: auto | yes | no
USE_GPU=auto
